# ai-router — copy to .env and fill in.
# .env is gitignored. Never commit real values.

# Absolute path to this project on the Docker host (used for bind mounts).
AI_ROUTER_DIR=/absolute/path/to/ai-router

# Postgres password for the stack.        openssl rand -base64 24
POSTGRES_PASSWORD=

# LiteLLM admin key — full control over the gateway. Never give this to a client.
#                                         echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# Encrypts stored credentials in the database.
# MUST NOT change after the first start — existing virtual keys become
# unreadable. Back it up next to POSTGRES_PASSWORD.
#                                         openssl rand -hex 32
LITELLM_SALT_KEY=

# Redis password (shared rate-limit and cache state).
#                                         openssl rand -base64 24
REDIS_PASSWORD=

# Anthropic API key. Optional — without it everything runs local-only and
# cloud tiers degrade to the local model.
ANTHROPIC_API_KEY=

# Ollama on the host. On Linux without Docker Desktop use the host gateway IP.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- created later, not needed to start ---
# Read-only Postgres role for Grafana; see sql/grafana-readonly-user.sql
GRAFANA_RO_PASSWORD=

# Bundled Grafana admin password (observability profile). Change it.
GRAFANA_ADMIN_PASSWORD=admin
